# FreshPrice: Grocery Shop Price Management Dashboard Environment Variables
#
# FOR LAPTOP-MOBILE REAL-TIME SYNCHRONIZATION ACROSS ALL DEVICES:
# 1. Create a free project at https://supabase.com
# 2. Run the migration script in supabase/migrations/20261031_complete_sync_schema.sql
# 3. Add these two environment variables in Vercel (Project Settings -> Environment Variables):
#    VITE_SUPABASE_URL=https://your-project.supabase.co
#    VITE_SUPABASE_ANON_KEY=your-anon-public-key
#
# When deployed, any laptop, mobile phone, or tablet visiting your website URL
# will instantly share the same database and sync price changes in real time!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
